# Cloudflare Pages 응답 헤더
# 이 앱은 백엔드가 없고 외부 스크립트를 하나도 쓰지 않으므로 CSP를 아주 좁게 잠글 수 있다.

/*
  # 스크립트는 같은 출처만. 인라인 스크립트가 없으므로 'unsafe-inline' 불필요.
  # style 은 HTML 안의 style="..." 속성 때문에 'unsafe-inline' 이 필요하다.
  # connect-src: 업데이트 확인(api.github.com) + 선택 기능인 AI 다듬기(api.anthropic.com) 두 곳뿐.
  # blob:/data: 는 PDF·MIDI·이미지 생성과 오디오 재생에 쓴다.
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self'; connect-src 'self' https://api.github.com https://api.anthropic.com; media-src 'self' blob: data:; worker-src 'self' blob:; object-src 'none'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'; upgrade-insecure-requests
  # 탭 오디오 캡처(getDisplayMedia)는 이 사이트에서만 허용, 나머지 민감 권한은 차단
  Permissions-Policy: display-capture=(self), microphone=(), camera=(), geolocation=(), payment=(), usb=(), interest-cohort=()
  X-Content-Type-Options: nosniff
  Referrer-Policy: no-referrer
  Cross-Origin-Opener-Policy: same-origin
  X-Frame-Options: DENY

# HTML 은 항상 최신을 받게 한다 (배포하면 바로 반영되도록)
/*.html
  Cache-Control: no-cache, must-revalidate

/
  Cache-Control: no-cache, must-revalidate

# 정적 자원은 짧게 캐시하되 재검증 (파일명에 해시가 없으므로 길게 잡지 않는다)
/app/*
  Cache-Control: public, max-age=300, must-revalidate

/assets/*
  Cache-Control: public, max-age=86400
