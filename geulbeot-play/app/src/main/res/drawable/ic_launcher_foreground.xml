<?xml version="1.0" encoding="utf-8"?>
<!--
  A sheet of paper with a folded corner, carrying the Hangul letter ㄱ - the first consonant, and
  the first thing anyone writes when learning the alphabet. Everything stays inside the 66dp safe
  zone so no launcher shape crops it.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Page -->
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M35,30 a5,5 0 0 1 5,-5 h20 l13,13 v44 a5,5 0 0 1 -5,5 h-28 a5,5 0 0 1 -5,-5 z" />
    <!-- Folded corner -->
    <path
        android:fillColor="#FFD3DDEC"
        android:pathData="M60,25 l13,13 h-9 a4,4 0 0 1 -4,-4 z" />
    <!-- The letter -->
    <path
        android:fillColor="#FF2F5597"
        android:pathData="M43,42 H65 V70 H59 V48 H43 Z" />
    <!-- Two ruled lines, so the page reads as written-on rather than blank -->
    <path android:fillColor="#FFC3CEE0" android:pathData="M43,75 h22 v3 h-22 z" />
    <path android:fillColor="#FFC3CEE0" android:pathData="M43,80 h14 v3 h-14 z" />
</vector>
