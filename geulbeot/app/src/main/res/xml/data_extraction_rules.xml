<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <!--
      See backup_rules.xml: one <include> per destination is an allow list, so only the settings
      file leaves the device and document content never does - not to the cloud, and not to a new
      phone.
    -->
    <cloud-backup>
        <include domain="sharedpref" path="geulbeot_settings.xml" />
    </cloud-backup>
    <device-transfer>
        <include domain="sharedpref" path="geulbeot_settings.xml" />
    </device-transfer>
</data-extraction-rules>
