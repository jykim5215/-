<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <!-- See backup_rules.xml: only settings leave the device, never document content. -->
    <cloud-backup>
        <include domain="sharedpref" path="geulbeot_settings.xml" />
        <exclude domain="file" path="recent_documents.json" />
        <exclude domain="file" path="autosave/" />
        <exclude domain="cache" path="." />
    </cloud-backup>
    <device-transfer>
        <include domain="sharedpref" path="geulbeot_settings.xml" />
        <exclude domain="file" path="autosave/" />
        <exclude domain="cache" path="." />
    </device-transfer>
</data-extraction-rules>
