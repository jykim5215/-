{
  "name": "dna-desk",
  "version": "0.3.0",
  "description": "디지스트신문 DNA 편집 지원 데스크톱 앱 — 기획부터 카드뉴스까지 6단계 워크플로우",
  "main": "main.js",
  "type": "commonjs",
  "scripts": {
    "start": "electron .",
    "test": "node --test tests/*.test.mjs",
    "eval": "node scripts/run-eval.mjs",
    "dist": "node scripts/make-dist-zip.mjs",
    "shortcut": "node scripts/create-shortcut.mjs",
    "pack": "electron-builder --dir",
    "installer": "electron-builder"
  },
  "author": "디지스트신문 DNA",
  "license": "MIT",
  "dependencies": {
    "@anthropic-ai/sdk": "^0.110.0",
    "jszip": "^3.10.1",
    "pdf-parse": "^1.1.1",
    "sql.js": "^1.14.1"
  },
  "devDependencies": {
    "electron": "^43.0.0",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "com.dgistdna.desk",
    "productName": "DNA 편집 스튜디오",
    "files": [
      "main.js",
      "preload.js",
      "renderer/**",
      "src/**",
      "rules/**",
      "prompts/**",
      "style_corpus/**",
      "assets/**"
    ],
    "extraResources": [
      { "from": "../templates", "to": "templates" }
    ],
    "linux": { "target": "AppImage", "icon": "assets/icon.svg", "category": "Office" },
    "win": { "target": "nsis" },
    "mac": { "target": "dmg" }
  }
}
