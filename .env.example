# 내 물가(My CPI) 환경변수 예시
# 이 파일을 .env 로 복사해서 값을 채운다. .env 는 .gitignore 에 있어 커밋되지 않는다.

# --- KOSIS OpenAPI (필수) ---------------------------------------------------
# kosis.kr/openapi 에서 개인도 즉시 자동 발급된다.
# 인증키가 URL 인코딩된 형태(%2B, %3D 등)로 발급되면 그대로 붙여넣어도 된다.
# 클라이언트가 디코딩해서 보낸다.
KOSIS_API_KEY=

# --- aT KAMIS 농산물 가격 (선택) --------------------------------------------
# 인증키와 계정 ID 두 개가 모두 필요하다. 없으면 ④ 장바구니 화면만 비활성화되고
# 나머지 화면은 정상 동작한다.
KAMIS_CERT_KEY=
KAMIS_CERT_ID=

# --- 오피넷 유가 (선택) ------------------------------------------------------
# 무료 키는 최근 7일만 제공하므로 시계열이 필요하면 일별 적재가 필요하다.
OPINET_API_KEY=

# --- 앱 설정 -----------------------------------------------------------------
MYCPI_DB_PATH=data/mycpi.sqlite3
MYCPI_HOST=127.0.0.1
MYCPI_PORT=8000
